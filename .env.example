JWT_SECRET_KEY=replace-this-with-a-long-random-string

# Comma-separated list of extra allowed CORS origins beyond the defaults
# already baked into app/main.py (which include https://www.sasmytrip.com
# and https://sasmytrip.com). Add any staging/preview domains here, e.g.
# CORS_EXTRA_ORIGINS=https://staging.sasmytrip.com,https://preview.sasmytrip.com
CORS_EXTRA_ORIGINS=

# ------------------------------------------------------------------
# TBO (tbo.com) Flight + Hotel API
# ------------------------------------------------------------------
# mock = sample data, no TBO account needed (default when TBO_USERNAME is empty)
# test = TBO staging / certification  (tektravels.com)
# live = production                   (travelboutiqueonline.com) — real tickets!
TBO_MODE=mock

# Air API + Hotel Book credentials (from TBO's integration mail)
TBO_CLIENT_ID=ApiIntegrationNew
TBO_USERNAME=
TBO_PASSWORD=
# Public IP of this server — TBO whitelists it on live
TBO_END_USER_IP=

# Hotel Search/PreBook Basic-Auth user (leave blank to reuse TBO_USERNAME/PASSWORD)
TBO_HOTEL_USERNAME=
TBO_HOTEL_PASSWORD=

# Hotel static data (CountryList / CityList / TBOHotelCodeList / Hoteldetails)
# Test user given in TBO docs: TBOStaticAPITest (password is on the Authorization page)
TBO_STATIC_USERNAME=
TBO_STATIC_PASSWORD=

# Your margin on top of TBO's published fare / room rate
TBO_MARKUP_PERCENT=0
TBO_MARKUP_FLAT_FLIGHT=0
TBO_MARKUP_FLAT_HOTEL=0

# Max hotel codes searched per city (TBO: 100 per call, run in parallel)
TBO_MAX_HOTEL_CODES=500
TBO_TIMEOUT_SECONDS=60

# Optional URL overrides — paste LIVE URLs from TBO's go-live mail here
# TBO_SHARED_URL=
# TBO_AIR_URL=
# TBO_HOTEL_SEARCH_URL=
# TBO_HOTEL_BOOK_URL=
# TBO_HOTEL_STATIC_URL=

# Save every TBO request/response as JSON (for TBO certification). Leave blank to disable.
TBO_LOG_DIR=
LOG_LEVEL=INFO

# Super Admin auto-created on startup (if missing)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=
SUPER_ADMIN_RESET_PASSWORD=false

# ------------------------------------------------------------------
# API provider per service (see SERVICES_API.md). "mock" = sample data.
# ------------------------------------------------------------------
TRAIN_PROVIDER=mock
BUS_PROVIDER=mock
CAB_PROVIDER=mock
CRUISE_PROVIDER=mock
HAJJ_UMRAH_PROVIDER=mock
TRAVEL_INSURANCE_PROVIDER=mock
MONEY_EXCHANGE_PROVIDER=mock
VISA_PROVIDER=mock
PACKAGE_PROVIDER=mock
ACTIVITY_PROVIDER=mock
