JWT_SECRET_KEY=replace-this-with-a-long-random-string

# Comma-separated list of extra allowed CORS origins beyond the defaults
# already baked into app/main.py (which include https://www.sasmytrip.com
# and https://sasmytrip.com). Add any staging/preview domains here, e.g.
# CORS_EXTRA_ORIGINS=https://staging.sasmytrip.com,https://preview.sasmytrip.com
CORS_EXTRA_ORIGINS=

# ------------------------------------------------------------------
# TBO (tbo.com) Flight + Hotel API — see TBO_INTEGRATION.md
# Leave TBO_USERNAME empty = mock mode (sample data). Fill it + set TBO_MODE=test for TBO staging.
# ------------------------------------------------------------------
TBO_MODE=mock
TBO_CLIENT_ID=ApiIntegrationNew
TBO_USERNAME=
TBO_PASSWORD=
TBO_END_USER_IP=
TBO_HOTEL_USERNAME=
TBO_HOTEL_PASSWORD=
TBO_STATIC_USERNAME=
TBO_STATIC_PASSWORD=
TBO_MARKUP_PERCENT=0
TBO_MARKUP_FLAT_FLIGHT=0
TBO_MARKUP_FLAT_HOTEL=0
TBO_LOG_DIR=

# ------------------------------------------------------------------
# Super Admin — created automatically on backend start if it doesn't exist.
# Set SUPER_ADMIN_RESET_PASSWORD=true once if you need to reset the password, then set it back to false.
# ------------------------------------------------------------------
SUPER_ADMIN_EMAIL=uidesignersaif@gmail.com
SUPER_ADMIN_PASSWORD=Saif@0011
SUPER_ADMIN_NAME=Saif
SUPER_ADMIN_PHONE=787041662
SUPER_ADMIN_RESET_PASSWORD=false
